{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "k=\"${CURSOR_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
        "timeout": 60
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "k=\"${CURSOR_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
        "timeout": 60
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write|Edit|Delete",
        "command": "k=\"${CURSOR_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
        "timeout": 60
      }
    ],
    "beforeShellExecution": [
      {
        "command": "k=\"${CURSOR_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
        "timeout": 60
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "k=\"${CURSOR_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "k=\"${CURSOR_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || { [ -f klin.json ] && echo '{\"systemMessage\":\"klin is not installed. Install it with: curl --proto =https --tlsv1.2 -LsSf https://github.com/brajevicm/klin/releases/latest/download/klin-installer.sh | sh\"}'; exit 0; }; \"$k\" __agent event",
        "timeout": 900
      }
    ]
  }
}
