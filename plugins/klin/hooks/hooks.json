{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
            "timeout": 60,
            "statusMessage": "klin: opening the turn"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
            "timeout": 60,
            "statusMessage": "klin: opening the turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" __agent event",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || { [ -f \"${CLAUDE_PROJECT_DIR:-.}/klin.json\" ] && echo '{\"systemMessage\":\"klin is not installed. Install it with: curl --proto =https --tlsv1.2 -LsSf https://github.com/brajevicm/klin/releases/latest/download/klin-installer.sh | sh\"}'; exit 0; }; \"$k\" __agent event",
            "timeout": 900,
            "statusMessage": "klin: gating the changed files"
          }
        ]
      }
    ]
  }
}
