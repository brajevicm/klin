#!/bin/sh
# Fetch the pinned klin release once, cache it, and execute it. ADR 0023, spec 19.2.
set -u

# Claude Code and Codex show systemMessage. Cursor's native stop shows followup_message.
# One object carries both, so a missing binary still tells the person on every host.
said() {
	printf '{"systemMessage":"%s","followup_message":"%s"}\n' "$1" "$1"
}

MANIFEST="$(dirname "$0")/../.claude-plugin/plugin.json"
VERSION=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$MANIFEST" 2>/dev/null | head -1)
if [ -z "$VERSION" ]; then
	said "klin: $MANIFEST names no version, so nothing was checked."
	exit 0
fi
BASE="${KLIN_RELEASE_BASE_URL:-https://github.com/brajevicm/klin/releases/download/v$VERSION}"
CACHE="${KLIN_CACHE_DIR:-$HOME/.cache/klin}/bin"
BINARY="$CACHE/$VERSION/klin"
HINTED="${KLIN_CACHE_DIR:-$HOME/.cache/klin}/hinted"
CLI="klin: this plugin runs klin's hooks. For the klin command itself, such as klin setup, install it: curl --proto =https --tlsv1.2 -LsSf https://github.com/brajevicm/klin/releases/latest/download/klin-installer.sh | sh"

target() {
	machine=$(uname -m)
	case "$machine" in
	arm64 | aarch64) machine=aarch64 ;;
	x86_64 | amd64) machine=x86_64 ;;
	*) return 1 ;;
	esac
	case "$(uname -s)" in
	Darwin) echo "$machine-apple-darwin" ;;
	Linux) echo "$machine-unknown-linux-gnu" ;;
	*) return 1 ;;
	esac
}

digest() {
	if command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | awk '{print $1}'
	elif command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | awk '{print $1}'
	else
		return 1
	fi
}

download() {
	curl --tlsv1.2 --proto-redir "=https" -fsL \
		--connect-timeout 5 --max-time 20 -o "$2" "$1"
}

# The binary moves into the cache only after the checksum matches, so a failure leaves
# nothing executable behind.
installed() {
	scratch=$1
	triple=$(target) || return 1
	archive="klin-$triple.tar.xz"
	download "$BASE/$archive" "$scratch/$archive" || return 1
	download "$BASE/$archive.sha256" "$scratch/$archive.sha256" || return 1
	want=$(awk '{print $1; exit}' "$scratch/$archive.sha256")
	got=$(digest "$scratch/$archive") || return 1
	[ -n "$want" ] || return 1
	[ "$want" = "$got" ] || return 1
	tar -xJf "$scratch/$archive" -C "$scratch" || return 1
	found=$(find "$scratch" -type f -name klin -print | head -1)
	[ -n "$found" ] || return 1
	chmod 755 "$found" || return 1
	mkdir -p "$CACHE/$VERSION" || return 1
	mv "$found" "$BINARY" || return 1
	# Another host's plugin may pin another version here, so a version a session ran this week stays.
	find "$CACHE" -mindepth 1 -maxdepth 1 -type d ! -name "$VERSION" ! -name '.fetch.*' -mtime +7 \
		-exec rm -rf {} + 2>/dev/null || true
}

if [ ! -x "$BINARY" ]; then
	scratch="$CACHE/.fetch.$$"
	mkdir -p "$scratch" 2>/dev/null
	installed "$scratch"
	outcome=$?
	rm -rf "$scratch"
	if [ "$outcome" -ne 0 ]; then
		# A binary a person installed by another route is better than no check at all.
		if on_path=$(command -v klin) && ! [ "$on_path" -ef "$0" ]; then
			exec "$on_path" "$@"
		fi
		said "klin: the pinned release $VERSION could not be installed, so nothing was checked."
		exit 0
	fi
fi

# A person without a klin of their own hears once that the CLI exists, in a repository that opted
# in: klin says nothing at all where the worktree root holds no klin.json. Cursor shows no
# message at a prompt, so the hint waits for another host. It is never a followup_message, which
# Cursor would submit as a prompt that hands the installer to the agent.
if [ "${1:-}" = __agent ]; then
	touch "$CACHE/$VERSION" 2>/dev/null
	if [ ! -e "$HINTED" ] && [ -z "${CURSOR_VERSION:-}" ] &&
		root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f "$root/klin.json" ] &&
		! { on_path=$(command -v klin) && ! [ "$on_path" -ef "$0" ]; }; then
		printed=$("$BINARY" "$@")
		outcome=$?
		if [ -n "$printed" ] || [ "$outcome" -ne 0 ]; then
			[ -z "$printed" ] || printf '%s\n' "$printed"
			exit "$outcome"
		fi
		mkdir "$HINTED" 2>/dev/null && printf '{"systemMessage":"%s"}\n' "$CLI"
		exit 0
	fi
fi

exec "$BINARY" "$@"
