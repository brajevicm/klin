{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT:-}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" radius",
            "timeout": 60,
            "statusMessage": "klin: opening the turn"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT:-}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" radius",
            "timeout": 60,
            "statusMessage": "klin: opening the turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT:-}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || exit 0; \"$k\" guard",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=\"${CLAUDE_PLUGIN_ROOT:-}/bin/klin\"; [ -x \"$k\" ] || k=$(command -v klin) || { [ -f \"${CLAUDE_PROJECT_DIR:-.}/klin.json\" ] && echo 'klin is not installed. Install it with: curl --proto \"=https\" --tlsv1.2 -LsSf https://github.com/brajevicm/klin/releases/latest/download/klin-installer.sh | sh'; exit 0; }; \"$k\" gate --hook --changed",
            "timeout": 900,
            "statusMessage": "klin: gating the changed files"
          }
        ]
      }
    ]
  }
}
