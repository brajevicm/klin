{
  "build": "cargo build --quiet --all-targets",
  "complexity": {
    "cc": 8,
    "lines": 60,
    "test_lines": 60,
    "in": ["src", "tests"]
  },
  "escapes": { "in": ["src", "tests"] },
  "doc_size": {
    "README.md": 1500,
    "CONTEXT.md": 1500,
    "AGENTS.md": 1500,
    "RELEASE_NOTES.md": 9999
  },
  "radius": {
    "directories": 4,
    "lines": 776
  },

  "conventions": {
    "single-git-boundary": {
      "code": "Command::new(\"git\")",
      "in": "src",
      "except": ["src/sys/git.rs", "src/sys/changed.rs"],
      "remedy": "Use the shared Git boundary."
    },
    "no-old-flags": {
      "text": "config::Flags",
      "in": "src",
      "remedy": "Use the explicit execution context."
    },
    "no-records-side-channel": {
      "code": "RefCell<Records>",
      "in": "src",
      "remedy": "Write through the explicit check Sink."
    },
    "exhaustive-cli-dispatch": {
      "code": "_ => Ok(0)",
      "in": "src/main.rs",
      "remedy": "Handle every CLI command explicitly."
    },
    "single-parser-owner": {
      "code": "Parser::new()",
      "in": "src",
      "except": "src/syntax",
      "remedy": "Use the shared syntax parser."
    }
  },
  "layering": {
    "acyclic": true,
    "layers": {
      "sys": { "in": "src/sys", "can_use": [] },
      "config": { "in": "src/config", "can_use": ["sys"] },
      "syntax": { "in": "src/syntax", "can_use": ["config", "sys"] },
      "facts": { "in": "src/facts", "can_use": ["syntax", "config", "sys"] },
      "modules": { "in": "src/modules", "can_use": ["facts", "syntax", "config", "sys"] },
      "surface": { "in": "src/surface", "can_use": ["modules", "facts", "syntax", "config", "sys"] },
      "window": { "in": "src/window", "can_use": ["surface", "modules", "facts", "syntax", "config", "sys"] },
      "contract": { "in": "src/contract", "can_use": ["window", "surface", "modules", "facts", "syntax", "config", "sys"] },
      "checks": { "in": "src/checks", "can_use": ["contract", "window", "surface", "modules", "facts", "syntax", "config", "sys"] },
      "engine": { "in": "src/engine", "can_use": ["checks", "contract", "window", "surface", "modules", "facts", "syntax", "config", "sys"] },
      "hook": { "in": "src/hook", "can_use": ["engine", "checks", "contract", "window", "surface", "modules", "facts", "syntax", "config", "sys"] },
      "cli": { "in": ["src/cli", "src/main.rs"], "can_use": ["hook", "engine", "checks", "contract", "window", "surface", "modules", "facts", "syntax", "config", "sys"] }
    }
  }
}
