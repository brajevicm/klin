{
  "project": "klin",
  "build": "cargo build --quiet --all-targets",
  "complexity": {
    "sources": ["src", "tests"],
    "ceilings": {
      "cc": 8,
      "lines": 60
    }
  },
  "doc_size": [
    {
      "file": "README.md",
      "ceiling": 200
    },
    {
      "file": "CONTEXT.md",
      "ceiling": 250
    },
    {
      "file": "AGENTS.md",
      "ceiling": 350
    }
  ],
  "escapes": {
    "roots": ["src", "tests"],
    "languages": ["rust"]
  }
}
