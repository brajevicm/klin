index 5fcb80f..728084d 100644
--- a/src/report.ts
+++ b/src/report.ts
@@ -1,5 +1,60 @@
-export type Row = { name: string; total: number };
+export type Row = { name: string; total: number; region?: string; kind?: string };
 
 export function toJson(rows: Row[]): string {
   return JSON.stringify(rows);
 }
+
+function csvField(value: string | number): string {
+  const text = String(value);
+  return /[",\n\r]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+export function toCsv(rows: Row[]): string {
+  return rows.map((row) => `${csvField(row.name)},${csvField(row.total)}`).join("\n");
+}
+
+const REGION_SUFFIX: Record<string, string> = {
+  EU: " (EU)",
+  US: " (US)",
+  APAC: " (APAC)",
+  LATAM: " (LATAM)",
+};
+
+const KIND_SUFFIX: Record<string, string> = {
+  refund: " refund",
+  credit: " credit",
+};
+
+function amountSuffix(row: Row): string {
+  if (row.total < 0 && row.kind !== "refund") return " negative";
+  if (row.total === 0 || row.total > 10000) return " check";
+  return "";
+}
+
+export function label(row: Row): string {
+  return (
+    row.name +
+    (REGION_SUFFIX[row.region ?? ""] ?? "") +
+    (KIND_SUFFIX[row.kind ?? ""] ?? "") +
+    amountSuffix(row)
+  );
+}
+
+function isRow(value: unknown): value is Row {
+  if (typeof value !== "object" || value === null) return false;
+  const row = value as Record<string, unknown>;
+  return (
+    typeof row.name === "string" &&
+    typeof row.total === "number" &&
+    (row.region === undefined || typeof row.region === "string") &&
+    (row.kind === undefined || typeof row.kind === "string")
+  );
+}
+
+export function fromJson(text: string): Row[] {
+  const parsed: unknown = JSON.parse(text);
+  if (!Array.isArray(parsed) || !parsed.every(isRow)) {
+    throw new Error("fromJson: expected an array of rows");
+  }
+  return parsed;
+}
