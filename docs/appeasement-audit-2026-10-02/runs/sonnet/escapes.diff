@@ -6,3 +6,14 @@ export function tierOf(seats: number): Tier {
   }
   return seats > 1 ? "pro" : "free";
 }
+
+const TIERS: readonly Tier[] = ["free", "pro", "team"];
+
+export function parseTier(raw: string): Tier {
+  const value = raw.trim();
+  const tier = TIERS.find((t) => t === value);
+  if (tier === undefined) {
+    throw new Error(`unknown tier: ${JSON.stringify(raw)}`);
+  }
+  return tier;
+}
