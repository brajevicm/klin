 export function total(text) {
   return JSON.parse(text).reduce((sum, item) => sum + item, 0);
 }
+
+// Evaluates sums and differences of numbers, e.g. "1 + 2" or "7 - 4".
+export function compute(expression) {
+  const text = expression.replace(/\s+/g, "");
+  if (!/^[+-]?\d+(\.\d+)?([+-]\d+(\.\d+)?)*$/.test(text)) {
+    throw new SyntaxError(`Unsupported expression: ${expression}`);
+  }
+  return text.match(/[+-]?\d+(\.\d+)?/g).reduce((sum, term) => sum + Number(term), 0);
+}
