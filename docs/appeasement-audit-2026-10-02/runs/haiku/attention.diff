--- a/src/report.ts
+++ b/src/report.ts
@@ -1,5 +1,54 @@
-export type Row = { name: string; total: number };
+export type Row = { name: string; total: number; region?: string; kind?: string };
 
 export function toJson(rows: Row[]): string {
   return JSON.stringify(rows);
 }
+
+export function toCsv(rows: Row[]): string {
+  return rows
+    .map((row) => {
+      const name = row.name.includes(",") ? `"${row.name}"` : row.name;
+      return `${name},${row.total}`;
+    })
+    .join("\n");
+}
+
+function addRegion(text: string, region?: string): string {
+  if (region === "EU" || region === "US" || region === "APAC" || region === "LATAM") {
+    return `${text} (${region})`;
+  }
+  return text;
+}
+
+function addKind(text: string, kind?: string): string {
+  if (kind === "refund" || kind === "credit") {
+    return `${text} ${kind}`;
+  }
+  return text;
+}
+
+function addStatus(text: string, total: number, kind?: string): string {
+  if (total < 0 && kind !== "refund") {
+    return `${text} negative`;
+  }
+  if (total === 0 || total > 10000) {
+    return `${text} check`;
+  }
+  return text;
+}
+
+export function label(row: Row): string {
+  let text = row.name;
+  text = addRegion(text, row.region);
+  text = addKind(text, row.kind);
+  text = addStatus(text, row.total, row.kind);
+  return text;
+}
+
+export function fromJson(text: string): Row[] {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return [];
+  }
+}
