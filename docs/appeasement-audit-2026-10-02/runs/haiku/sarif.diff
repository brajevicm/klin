 export function total(text) {
   return JSON.parse(text).reduce((sum, item) => sum + item, 0);
 }
+
+export function compute(expression) {
+  const tokens = expression.match(/\d+\.?\d*|[+\-*/()]/g) || [];
+  let pos = 0;
+  function parseNum() {
+    if (tokens[pos] === '(') { pos++; const r = parseAdd(); pos++; return r; }
+    return +tokens[pos++];
+  }
+  const parseMul = () => { let r = parseNum(); while ('*/'.includes(tokens[pos])) r = tokens[pos++] === '*' ? r * parseNum() : r / parseNum(); return r; };
+  const parseAdd = () => { let r = parseMul(); while ('+-'.includes(tokens[pos])) r = tokens[pos++] === '+' ? r + parseMul() : r - parseMul(); return r; };
+  return parseAdd();
+}
