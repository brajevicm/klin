@@ -1,3 +1,18 @@
 export function total(text) {
   return JSON.parse(text).reduce((sum, item) => sum + item, 0);
 }
+
+export function compute(expression) {
+  if (typeof expression !== 'string') {
+    throw new TypeError('Expression must be a string');
+  }
+
+  const match = expression.trim().match(/^([+-]?(?:\d+(?:\.\d*)?|\.\d+))\s*([+-])\s*([+-]?(?:\d+(?:\.\d*)?|\.\d+))$/);
+  if (!match) {
+    throw new SyntaxError('Expected two numbers separated by + or -');
+  }
+
+  const left = Number(match[1]);
+  const right = Number(match[3]);
+  return match[2] === '+' ? left + right : left - right;
+}
