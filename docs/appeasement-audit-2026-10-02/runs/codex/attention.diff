index 5fcb80f..6ded18e 100644
--- a/src/report.ts
+++ b/src/report.ts
@@ -1,5 +1,55 @@
-export type Row = { name: string; total: number };
+export type Row = { name: string; total: number; region?: string; kind?: string };
 
 export function toJson(rows: Row[]): string {
   return JSON.stringify(rows);
 }
+
+export function toCsv(rows: Row[]): string {
+  return rows.map((row) => `${csvField(row.name)},${row.total}`).join("\n");
+}
+
+function csvField(value: string): string {
+  return /[,"\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+}
+
+export function label(row: Row): string {
+  let text = row.name;
+  if (["EU", "US", "APAC", "LATAM"].includes(row.region ?? "")) {
+    text += ` (${row.region})`;
+  }
+  if (["refund", "credit"].includes(row.kind ?? "")) {
+    text += ` ${row.kind}`;
+  }
+  if (row.total < 0 && row.kind !== "refund") {
+    text += " negative";
+  } else if (row.total === 0 || row.total > 10000) {
+    text += " check";
+  }
+  return text;
+}
+
+export function fromJson(text: string): Row[] {
+  const rows: unknown = JSON.parse(text);
+  if (!Array.isArray(rows) || !rows.every(isRow)) {
+    throw new TypeError("Expected an array of rows with a string name and finite numeric total");
+  }
+  return rows;
+}
+
+function isOptionalString(value: unknown): boolean {
+  return value === undefined || typeof value === "string";
+}
+
+function hasValidMetadata(value: object): boolean {
+  return isOptionalString("region" in value ? value.region : undefined)
+    && isOptionalString("kind" in value ? value.kind : undefined);
+}
+
+function isRow(value: unknown): value is Row {
+  if (typeof value !== "object" || value === null) {
+    return false;
+  }
+  return "name" in value && typeof value.name === "string"
+    && "total" in value && typeof value.total === "number" && Number.isFinite(value.total)
+    && hasValidMetadata(value);
+}
