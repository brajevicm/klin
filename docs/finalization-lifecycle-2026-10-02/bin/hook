#!/usr/bin/env bash
set -u
event=$(cat)
case ${1:?} in
  session) cat "${PROBE_CONTEXT:?}" ;;
  stop)
    root=$(git rev-parse --show-toplevel); cd "$root"
    idx="$(git rev-parse --absolute-git-dir)/probe-stop.idx"
    rm -f "$idx"; GIT_INDEX_FILE=$idx git add -A; tree=$(GIT_INDEX_FILE=$idx git write-tree)
    active=$(printf '%s' "$event" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("stop_hook_active"))')
    printf 'stop\t%s\t%s\t%s\n' "$(date +%s)" "$active" "$tree" >> "${PROBE_LOG:?}"
    printf '%s\n' "$event" >> "${PROBE_LOG%.log}.stops.jsonl" ;;
esac
exit 0
