#!/usr/bin/env bash
set -u
event=$(cat)
root=$(git rev-parse --show-toplevel); cd "$root"
settings="$(git rev-parse --absolute-git-dir)/probe.env"
[ -n "${PROBE_LOG:-}" ] || [ ! -f "$settings" ] || . "$settings"
field() { printf '%s' "$event" | python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1]))' "$1"; }
cursor=$(field cursor_version)
case ${1:?} in
  session)
    printf 'session\t%s\t%s\n' "$(date +%s)" "$cursor" >> "${PROBE_LOG:?}"
    if [ "$cursor" = None ]; then cat "${PROBE_CONTEXT:?}"
    else python3 -c 'import json,sys; print(json.dumps({"additional_context": open(sys.argv[1]).read()}))' "${PROBE_CONTEXT:?}"
    fi ;;
  stop)
    scratch=$(mktemp -d); trap 'rm -rf "$scratch"' EXIT
    tree=$(export GIT_INDEX_FILE="$scratch/index" GIT_OBJECT_DIRECTORY="$scratch/objects" GIT_ALTERNATE_OBJECT_DIRECTORIES="$(git rev-parse --absolute-git-dir)/objects"
      mkdir -p "$GIT_OBJECT_DIRECTORY" && git add -A && git write-tree)
    if [ "$cursor" = None ]; then said=$(field stop_hook_active)
    else said="$(field status)/$(field loop_count)"
    fi
    printf 'stop\t%s\t%s\t%s\n' "$(date +%s)" "$said" "$tree" >> "${PROBE_LOG:?}"
    printf '%s\n' "$event" >> "${PROBE_LOG%.log}.stops.jsonl" ;;
esac
exit 0
