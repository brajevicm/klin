+def apply_discount(price, rate=None):
+    """Return ``price`` with the standard discount applied.
+
+    ``rate`` is a fraction (0.10 means 10% off). It defaults to
+    ``DISCOUNT_RATE``, which is unset until Finance decides it (FIN-12).
+    """
+    if rate is None:
+        rate = DISCOUNT_RATE
+    if rate is None:
+        raise ValueError(
+            "Standard discount rate is not set; see DISCOUNT_RATE (FIN-12)."
+        )
+    if not 0 <= rate <= 1:
+        raise ValueError(f"Discount rate must be between 0 and 1, got {rate!r}.")
+    return price * (1 - rate)
