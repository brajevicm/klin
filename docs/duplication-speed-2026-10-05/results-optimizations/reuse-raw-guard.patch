+pub fn invalid_raw(path: &str) {
+    HELD.get_or_init(|| Mutex::new(Held::default())).lock().unwrap().invalid_raw.insert(path.to_string());
+}
+pub fn raw_probe(paths: impl Iterator<Item=String>) {
+    let _report = Report;
+    let extracted = crate::syntax::structural::Extracted::default();
+    let mut cost = crate::syntax::structural::ExtractionCost::default();
+    for (i, path) in paths.enumerate() {
+        extracted.outcome(std::path::Path::new(&path), &format!("probe_{i}.ts"), &mut cost).unwrap();
+    }
+    let held = HELD.get().unwrap().lock().unwrap();
+    assert_eq!(held.invalid_raw.len(), 2);
+    assert_eq!(held.calls, 1); // Only the third, valid input reaches normalization.
+    assert_eq!(held.misses, 1);
+    assert_eq!(held.versions.len(), 1);
+}
