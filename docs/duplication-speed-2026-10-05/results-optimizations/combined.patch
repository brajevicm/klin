+use crate::dup_research::{artifact_shared, SharedArtifact};
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+struct Version { source: Vec<u8>, artifact: SharedArtifact }
+#[derive(Default)]
+struct Held {
+    versions: HashMap<String, Vec<Version>>,
+    calls: usize, hits: usize, misses: usize, changed_paths: usize,
+    tokens: usize, prints: usize, nanos: u128, retained: usize,
+    checksum: u64,
+}
+static HELD: OnceLock<Mutex<Held>> = OnceLock::new();
+pub fn consume(path: &str, source: &[u8], root: tree_sitter::Node) {
+    let started = Instant::now();
+    let reuse = std::env::var("KLIN_DUP_REUSE").as_deref() == Ok("1");
+    let mut held = HELD.get_or_init(|| Mutex::new(Held::default())).lock().unwrap();
+    held.calls += 1;
+    let found = reuse.then(|| held.versions.get(path).and_then(|versions|
+        versions.iter().find(|v| v.source == source))).flatten();
+    let (tokens, prints, checksum) = if let Some(v) = found {
+        let checksum = v.artifact.prints.iter().fold(0u64, |sum, (key,pos)| sum.wrapping_add(*key ^ *pos as u64));
+        (v.artifact.tokens.len(), v.artifact.prints.len(), checksum)
+    } else {
+        let Some(artifact) = artifact_shared(path, source, root) else {
+            held.nanos += started.elapsed().as_nanos();
+            return;
+        };
+        let checksum = artifact.prints.iter().fold(0u64, |sum, (key,pos)| sum.wrapping_add(*key ^ *pos as u64));
+        let counts = (artifact.tokens.len(), artifact.prints.len(), checksum);
+        held.misses += 1;
+        if reuse {
+            if held.versions.contains_key(path) { held.changed_paths += 1; }
+            held.retained += source.len() + artifact.bytes() + std::mem::size_of::<Version>();
+            if !held.versions.contains_key(path) { held.retained += path.len(); }
+            held.versions.entry(path.to_string()).or_default().push(Version {source:source.to_vec(), artifact});
+        }
+        held.tokens += counts.0;
+        held.prints += counts.1;
+        held.checksum = held.checksum.wrapping_add(counts.2);
+        held.nanos += started.elapsed().as_nanos();
+        return;
+    };
+    held.hits += 1;
+    held.tokens += tokens;
+    held.prints += prints;
+    held.checksum = held.checksum.wrapping_add(checksum);
+    held.nanos += started.elapsed().as_nanos();
+}
+pub struct Report;
+impl Drop for Report {
+    fn drop(&mut self) {
+        if std::env::var_os("KLIN_DUP_RESEARCH_REPORT").is_none() { return; }
+        let held = HELD.get_or_init(|| Mutex::new(Held::default())).lock().unwrap();
+        eprintln!("DUP_RESEARCH {}", serde_json::json!({
+            "shared_files": held.calls, "reuse_hits":held.hits, "derived_inputs":held.misses,
+            "changed_same_paths":held.changed_paths, "unique_paths":held.versions.len(),
+            "tokens":held.tokens, "fingerprints":held.prints,"checksum":held.checksum,
+            "normalize_ms":held.nanos as f64 / 1e6,
+            "retained_payload_bytes":held.retained,
+            "extra_parses":0,"unchanged_source_reads":0,
+            "scope":"full-input same-path per-run reuse; retains tokens/rows/safety/actual selected prints; excludes index/lineage"
+        }));
+    }
+}
+
+pub fn probe_assertions() {
+    let held = HELD.get().unwrap().lock().unwrap();
+    assert_eq!((held.calls, held.hits, held.misses, held.changed_paths, held.versions.len()), (6,2,4,1,3));
+    assert!(!held.versions["a/main.ts"][0].artifact.prints.is_empty());
+    let left = &held.versions["a/main.ts"][0].artifact.tokens;
+    let renamed = &held.versions["b/main.ts"][0].artifact.tokens;
+    assert_ne!(left, renamed, "path-dependent import provenance must differ");
+    assert_ne!(left, &held.versions["a/main.ts"][1].artifact.tokens);
+}
