+// Research artifact retained by the per-run full-input reuse experiment.
+pub(crate) struct SharedArtifact {
+    pub tokens: Vec<u64>,
+    pub rows: Vec<u32>,
+    pub safe: Vec<bool>,
+    pub prints: Vec<(u64, u32)>,
+    pub unsafe_units: usize,
+    pub error: bool,
+}
+impl SharedArtifact {
+    pub fn bytes(&self) -> usize {
+        self.tokens.capacity() * std::mem::size_of::<u64>()
+            + self.rows.capacity() * std::mem::size_of::<u32>()
+            + self.safe.capacity() * std::mem::size_of::<bool>()
+            + self.prints.capacity() * std::mem::size_of::<(u64,u32)>()
+            + std::mem::size_of::<Self>()
+    }
+}
+pub(crate) fn artifact_shared(path: &str, source: &[u8], root: Node) -> Option<SharedArtifact> {
+    let lang = Lang::of(path)?;
+    let parsed = normalized_root(lang, path, source, root, false);
+    let prints = fingerprints(&parsed, Params {k:41,w:20,t:5,cap:64,bits:64});
+    Some(SharedArtifact {tokens: parsed.tokens,rows:parsed.rows,safe:parsed.safe,
+        prints,unsafe_units:parsed.unsafe_units,error:parsed.error})
+}
