+fn exact<T: PartialEq + Default>(
+    mine: &[T],
+    theirs: &[T],
+    first: i64,
+    diagonal: i64,
+    end: usize,
+) -> (usize, i64) {
+    let at = |position: i64| -> Option<(&T, &T)> {
+        let other = position + diagonal;
+        if position < 0
+            || other < 0
+            || position as usize >= mine.len()
+            || other as usize >= theirs.len()
+        {
+            return None;
+        }
+        let (a, b) = (&mine[position as usize], &theirs[other as usize]);
+        if a == &T::default() || b == &T::default() {
+            return None;
+        }
+        Some((a, b))
+    };
+    if (first..end as i64).any(|p| at(p).is_none_or(|(a, b)| a != b)) {
+        return (0, first);
+    }
+    let mut start = first;
+    while at(start - 1).is_some_and(|(a, b)| a == b) {
+        start -= 1;
+    }
+    let mut stop = end as i64;
+    while at(stop).is_some_and(|(a, b)| a == b) {
+        stop += 1;
+    }
+    ((stop - start) as usize, start)
+}
