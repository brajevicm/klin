+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tokens(path: &str, source: &str) -> Vec<u64> {
+        let lang = Lang::of(path).unwrap();
+        let syntax = Shared::new().parse(lang, source.as_bytes());
