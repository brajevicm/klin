+import csv
+import io
 import json
 
 
 def to_json(rows):
     return json.dumps(rows)
+
+
+def to_csv(rows):
+    out = io.StringIO()
+    if rows:
+        # header comes from the first row's keys; later extra keys raise ValueError
+        writer = csv.DictWriter(out, fieldnames=list(rows[0]), lineterminator="\n")
+        writer.writeheader()
+        writer.writerows(rows)
+    return out.getvalue()
