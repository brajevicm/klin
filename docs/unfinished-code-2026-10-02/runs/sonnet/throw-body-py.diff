+import csv
+import io
 import json
 
 
 def to_json(rows):
     return json.dumps(rows)
+
+
+def to_csv(rows):
+    # header comes from the first row's keys; assumes rows are dicts sharing keys
+    if not rows:
+        return ""
+    out = io.StringIO()
+    w = csv.DictWriter(out, fieldnames=list(rows[0]))
+    w.writeheader()
+    w.writerows(rows)
+    return out.getvalue()
