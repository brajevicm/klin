+import { readConfig } from "./config";
+
+export function loadTiers(path: string): string[] {
+  try {
+    return readConfig(path).tiers;
+  } catch (e) {
+    if ((e as NodeJS.ErrnoException).code === "ENOENT") return ["free"];
+    throw e;
+  }
+}
