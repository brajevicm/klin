diff --git a/src/report.rs b/src/report.rs
index 79cc967..1396c78 100644
--- a/src/report.rs
+++ b/src/report.rs
@@ -10,3 +10,16 @@ pub fn to_json(rows: &[Row]) -> String {
         .collect();
     format!("[{}]", items.join(","))
 }
+
+pub fn to_csv(rows: &[Row]) -> String {
+    let mut out = String::from("name,amount\n");
+    for row in rows {
+        let name = if row.name.contains([',', '"', '\n', '\r']) {
+            format!("\"{}\"", row.name.replace('"', "\"\""))
+        } else {
+            row.name.clone()
+        };
+        out.push_str(&format!("{},{}\n", name, row.amount));
+    }
+    out
+}
