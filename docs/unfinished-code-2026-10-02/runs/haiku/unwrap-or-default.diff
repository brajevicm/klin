+use crate::config;
+use std::io;
+
+pub fn load_tiers(path: &str) -> Vec<String> {
+    match config::read(path) {
+        Ok(config) => config.tiers,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => vec!["free".to_string()],
+        Err(error) => panic!("{error}"),
+    }
+}
