+import csv
+import io
 import json
 
 
 def to_json(rows):
     return json.dumps(rows)
+
+
+def to_csv(rows):
+    output = io.StringIO()
+    if rows:
+        writer = csv.DictWriter(output, fieldnames=rows[0].keys())
+        writer.writeheader()
+        writer.writerows(rows)
+    return output.getvalue()
