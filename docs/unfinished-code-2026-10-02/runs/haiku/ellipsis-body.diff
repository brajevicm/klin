+import csv
 import json
+from io import StringIO
 
 
 def to_json(rows):
     return json.dumps(rows)
+
+
+def to_csv(rows):
+    if not rows:
+        return ""
+    output = StringIO()
+    writer = csv.DictWriter(output, fieldnames=rows[0].keys())
+    writer.writeheader()
+    writer.writerows(rows)
+    return output.getvalue()
