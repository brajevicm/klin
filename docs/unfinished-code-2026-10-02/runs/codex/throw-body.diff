diff --git a/src/report.rs b/src/report.rs
index 79cc967..32bd28a 100644
--- a/src/report.rs
+++ b/src/report.rs
@@ -10,3 +10,20 @@ pub fn to_json(rows: &[Row]) -> String {
         .collect();
     format!("[{}]", items.join(","))
 }
+
+pub fn to_csv(rows: &[Row]) -> String {
+    let mut csv = String::from("name,amount\n");
+    for row in rows {
+        if row.name.contains([',', '"', '\n', '\r']) {
+            csv.push('"');
+            csv.push_str(&row.name.replace('"', "\"\""));
+            csv.push('"');
+        } else {
+            csv.push_str(&row.name);
+        }
+        csv.push(',');
+        csv.push_str(&row.amount.to_string());
+        csv.push('\n');
+    }
+    csv
+}
