+import csv
+import io
 import json
 
 
 def to_json(rows):
     return json.dumps(rows)
+
+
+def to_csv(rows):
+    rows = iter(rows)
+    first = next(rows, None)
+    if first is None:
+        return ""
+
+    output = io.StringIO(newline="")
+    writer = csv.DictWriter(output, fieldnames=list(first))
+    writer.writeheader()
+    writer.writerow(first)
+    writer.writerows(rows)
+    return output.getvalue()
