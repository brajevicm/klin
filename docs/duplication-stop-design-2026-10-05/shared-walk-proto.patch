+// Walk only branches canonical capture skips; reference extraction must still see them.
+fn visit_descendants<'tree>(node: Node<'tree>, visit: &mut impl FnMut(Node<'tree>)) {
+    let mut cursor = node.walk();
+    if !cursor.goto_first_child() {
+        return;
+    }
+    loop {
+        visit(cursor.node());
+        if cursor.goto_first_child() {
+            continue;
+        }
+        loop {
+            if cursor.goto_next_sibling() {
+                break;
+            }
+            if !cursor.goto_parent() || cursor.node() == node {
+                return;
+            }
+        }
+    }
+}
