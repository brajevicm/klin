+const IDENTITY_VERSION: &str = "complexity/1";
+
+const MODIFIERS: &[&str] = &["static", "get", "set"];
+
+/// The named path from the file to one function, innermost last. A function the syntax names
+/// only by a binding takes the binding's name. Err where a step has no name the syntax gives.
+fn identity(site: Node, source: &str) -> Result<String, &'static str> {
+    let text = |node: Node| node.utf8_text(source.as_bytes()).unwrap_or_default();
+    let mut path = Vec::new();
+    let mut at = Some(site);
+    while let Some(node) = at {
+        let field = node
+            .child_by_field_name("name")
+            .or_else(|| (node.kind() == "pair").then(|| node.child_by_field_name("key")).flatten())
+            .or_else(|| {
+                (node.kind() == "assignment_expression")
+                    .then(|| node.child_by_field_name("left"))
+                    .flatten()
+            });
+        if node.kind() == "impl_item" {
+            let named = |field: &str| {
+                node.child_by_field_name(field).map(|part| {
+                    let part = match part.kind() {
+                        "generic_type" => part.child_by_field_name("type").unwrap_or(part),
+                        _ => part,
+                    };
+                    text(part).split_whitespace().collect::<Vec<_>>().join(" ")
+                })
+            };
+            let mut step = format!("impl {}", named("type").unwrap_or_default());
+            if let Some(name) = named("trait") {
+                step.push_str(&format!(" as {name}"));
+            }
+            path.push(step);
+        } else if let Some(name) = field {
+            match name.kind() {
+                "computed_property_name" | "subscript_expression" => {
+                    return Err(if node == site { "computed" } else { "ancestry" });
+                }
+                kind if kind.contains("pattern") => {
+                    return Err(if node == site { "anonymous" } else { "ancestry" });
+                }
+                _ => {}
+            }
+            let mut step = text(name).to_string();
+            let mut cursor = node.walk();
+            for modifier in node
+                .children(&mut cursor)
+                .filter(|child| !child.is_named() && MODIFIERS.contains(&child.kind()))
+            {
+                step = format!("{} {step}", modifier.kind());
+            }
+            path.push(step);
+        } else if node == site || node.kind().contains("function") || node.kind().contains("lambda") || node.kind().contains("closure") || node.kind() == "method_definition" {
+            let named_by_parent = node.parent().is_some_and(|parent| {
+                matches!(
+                    parent.kind(),
+                    "variable_declarator" | "pair" | "public_field_definition" | "field_definition" | "assignment_expression"
+                )
+            });
+            if !named_by_parent {
+                return Err(if node == site { "anonymous" } else { "ancestry" });
+            }
+        }
+        at = node.parent();
+    }
+    path.reverse();
+    Ok(path.join(" > "))
+}
