+/// Two identified sites of one version pair by key. Where the keys differ, the declaration text
+/// may still pair them, unless either key names a site of the other tree: then identity proves
+/// each has its own counterpart.
+fn same_site(finding: &Finding, entry: &Values) -> bool {
+    if !is_accepted(entry)
+        && let (Some((now_version, now)), Some((was_version, was))) =
+            (identified(&finding.values), identified(entry))
+        && now_version == was_version
+    {
+        if now == was {
+            return true;
+        }
+        if persists(&finding.values) || persists(entry) {
+            return false;
+        }
+    }
+    text(entry, "text") == finding.text
+}
