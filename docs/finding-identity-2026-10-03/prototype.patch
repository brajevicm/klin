+/// The judge for a gate whose files in some languages carry an identity. A file outside them
+/// takes today's first pass exactly; the body-hash pass runs once over what both leave.
+fn judge_scoped(
+    findings: Vec<Finding>,
+    entries: Vec<Values>,
+    metrics: &[&str],
+    scoped: fn(&str) -> bool,
+) -> Comparison {
+    let mut comparison = Comparison::default();
+    let (scoped_findings, plain_findings): (Vec<Finding>, Vec<Finding>) =
+        findings.into_iter().partition(|finding| scoped(&finding.file));
+    let (scoped_entries, plain_entries): (Vec<Values>, Vec<Values>) =
+        entries.into_iter().partition(|entry| scoped(&text(entry, "file")));
+    let (mut findings_left, mut entries_left) =
+        text_pass(&mut comparison, plain_findings, plain_entries, metrics);
+    let (more_findings, more_entries) =
+        identity_pass(&mut comparison, scoped_findings, scoped_entries, metrics);
+    findings_left.extend(more_findings);
+    entries_left.extend(more_entries);
+    finish(comparison, findings_left, entries_left, metrics)
