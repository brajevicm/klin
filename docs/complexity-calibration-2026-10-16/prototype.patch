+
+const DEPTH_FLOOR: u64 = 4;
+const COG_FLOOR: u64 = 15;
+const JSX: &[&str] = &["jsx_element", "jsx_self_closing_element"];
+const NESTS: &[&str] = &[
+    "if_statement",
+    "for_statement",
+    "for_in_statement",
+    "while_statement",
+    "do_statement",
+    "switch_statement",
+    "catch_clause",
+    "ternary_expression",
+];
+
+fn variant() -> &'static str {
+    static VARIANT: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    VARIANT.get_or_init(|| std::env::var("EXP585").unwrap_or_else(|_| "base".into()))
+}
+
+#[derive(Clone, Copy, Default)]
+struct Shape {
+    jsx: bool,
+    logic: u64,
+    depth: u64,
+    bumps: u64,
+    cog: u64,
+}
+
+fn shape(node: Node, at: &Walked) -> Shape {
+    let mut rows = BTreeSet::new();
+    jsx_rows(node, &mut rows);
+    let lines = (node.end_position().row - node.start_position().row + 1) as u64;
+    let body = node.child_by_field_name("body");
+    Shape {
+        jsx: !rows.is_empty(),
+        logic: lines.saturating_sub(rows.len() as u64).max(1),
+        depth: depth_of(node, 0, at),
+        bumps: body.map_or(0, |body| bumps(body, at)),
+        cog: cognitive(node, 0, at),
+    }
+}
+
+fn jsx_rows(node: Node, rows: &mut BTreeSet<usize>) {
+    if JSX.contains(&node.kind()) {
+        rows.extend(node.start_position().row..=node.end_position().row);
+        return;
+    }
+    let mut cursor = node.walk();
+    for child in node.children(&mut cursor) {
+        jsx_rows(child, rows);
+    }
+}
+
+fn nests(node: Node) -> bool {
+    NESTS.contains(&node.kind())
+        && !(node.kind() == "if_statement"
+            && node.parent().is_some_and(|parent| parent.kind() == "else_clause"))
+}
+
+fn depth_of(node: Node, depth: u64, at: &Walked) -> u64 {
+    let mut deepest = depth;
+    let mut cursor = node.walk();
+    for child in node.children(&mut cursor) {
+        if at.language.functions.contains(&child.kind()) {
+            continue;
+        }
+        let inner = depth + u64::from(nests(child));
+        deepest = deepest.max(depth_of(child, inner, at));
+    }
+    deepest
+}
+
+fn bumps(body: Node, at: &Walked) -> u64 {
+    let statements: Vec<Node> = match body.kind() {
+        "statement_block" => {
+            let mut cursor = body.walk();
+            body.named_children(&mut cursor).collect()
+        }
+        _ => vec![body],
+    };
+    let mut count = 0;
+    let mut inside = false;
+    for statement in statements {
+        let deep = depth_of(statement, u64::from(nests(statement)), at) >= 2;
+        if deep && !inside {
+            count += 1;
+        }
+        inside = deep;
+    }
+    count
+}
+
+fn logical(node: Node) -> Option<&'static str> {
+    if node.kind() != "binary_expression" {
+        return None;
+    }
+    let operator = node.child_by_field_name("operator")?.kind();
+    ["&&", "||", "??"].into_iter().find(|wanted| *wanted == operator)
+}
+
+fn cognitive(node: Node, nesting: u64, at: &Walked) -> u64 {
+    let mut total = 0;
+    let mut cursor = node.walk();
+    for child in node.children(&mut cursor) {
+        let kind = child.kind();
+        if at.language.functions.contains(&kind) {
+            continue;
+        }
+        total += match kind {
+            "if_statement" if child.parent().is_some_and(|parent| parent.kind() == "else_clause") => {
+                1 + cognitive(child, nesting.saturating_sub(1) + 1, at)
+            }
+            "else_clause" => {
+                let chained = {
+                    let mut inner = child.walk();
+                    child.named_children(&mut inner).any(|grand| grand.kind() == "if_statement")
+                };
+                match chained {
+                    true => cognitive(child, nesting, at),
+                    false => 1 + cognitive(child, nesting, at),
+                }
+            }
+            _ if NESTS.contains(&kind) => 1 + nesting + cognitive(child, nesting + 1, at),
+            _ => {
+                let sequence = logical(child).is_some_and(|operator| {
+                    let mut parent = child.parent();
+                    while let Some(above) = parent.filter(|above| above.kind() == "parenthesized_expression") {
+                        parent = above.parent();
+                    }
+                    parent.and_then(logical) != Some(operator)
+                });
+                u64::from(sequence) + cognitive(child, nesting, at)
+            }
+        };
+    }
+    total
+}
