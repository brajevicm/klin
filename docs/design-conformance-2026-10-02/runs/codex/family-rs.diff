+use shop::db::orders::order_total;
+use shop::payments::{checkout::checkout, registry::providers};
+
+#[test]
+fn checkout_charges_adyen_and_saves_order() {
+    let charge_id = checkout("adyen", 1234).unwrap();
+    assert_eq!(
+        charge_id,
+        "POST /adyen/payments {\"amount\":{\"value\":1234,\"currency\":\"EUR\"}}"
+    );
+    assert_eq!(order_total(&charge_id), Some(1234));
+}
+
+#[test]
+fn registered_adyen_provider_supports_refunds() {
+    let providers = providers();
+    let (_, provider) = providers.iter().find(|(name, _)| *name == "adyen").unwrap();
+    provider.refund("payment_123").unwrap();
+}
