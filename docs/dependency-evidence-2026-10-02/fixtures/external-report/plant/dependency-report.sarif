{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "dependency-report",
          "rules": [
            {
              "id": "registry/absent"
            },
            {
              "id": "registry/young"
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "registry/absent",
          "level": "error",
          "message": {
            "text": "csv-row-guard has no release on registry.npmjs.org in the snapshot of 2026-10-02"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
