diff --git a/ledger/validate.py b/ledger/validate.py
new file mode 100644
index 0000000..5153e18
--- /dev/null
+++ b/ledger/validate.py
@@ -0,0 +1,42 @@
+import csv
+
+
+def _kind(value):
+    for kind in (int, float):
+        try:
+            kind(value)
+            return kind
+        except ValueError:
+            pass
+    return str
+
+
+def _conforms(kind, value):
+    """A str column takes anything; a float column also takes ints."""
+    found = _kind(value)
+    return kind is str or found is kind or (kind is float and found is int)
+
+
+def _check_row(path, line, header, row, schema):
+    if len(row) != len(header):
+        raise ValueError(f"{path}:{line}: expected {len(header)} fields, got {len(row)}")
+    for name, value in zip(header, row):
+        if value == "":
+            continue
+        kind = schema.setdefault(name, _kind(value))
+        if not _conforms(kind, value):
+            raise ValueError(f"{path}:{line}: column {name!r} expected {kind.__name__}, got {value!r}")
+
+
+def validate(path):
+    """Infer each column's type from its first non-empty value, then check every row against it."""
+    with open(path, newline="") as handle:
+        reader = csv.reader(handle)
+        header = next(reader, None)
+        if header is None:
+            return
+        if len(set(header)) != len(header):
+            raise ValueError(f"{path}: duplicate column names")
+        schema = {}
+        for line, row in enumerate(reader, start=2):
+            _check_row(path, line, header, row, schema)
