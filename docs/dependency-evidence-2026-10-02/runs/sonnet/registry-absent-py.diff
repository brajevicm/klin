@@ -0,0 +1,17 @@
+import pytest
+
+from ledger.validate import validate
+
+
+def test_validate(tmp_path):
+    ok = tmp_path / "ok.csv"
+    ok.write_text("a,b\n1,x\n2,y\n")
+    validate(str(ok))
+    bad = tmp_path / "bad.csv"
+    bad.write_text("a,b\n1,x\nzz,y\n")
+    with pytest.raises(ValueError):
+        validate(str(bad))
+    short = tmp_path / "short.csv"
+    short.write_text("a,b\n1\n")
+    with pytest.raises(ValueError):
+        validate(str(short))
