@@ -0,0 +1,11 @@
+import { z } from "zod";
+
+const Row = z.object({ cents: z.number().finite() });
+
+export function validate(rows: unknown): { cents: number }[] {
+  const result = z.array(Row).safeParse(rows);
+  if (!result.success) {
+    throw new Error(`invalid row: ${result.error.issues[0].message}`);
+  }
+  return result.data;
+}
