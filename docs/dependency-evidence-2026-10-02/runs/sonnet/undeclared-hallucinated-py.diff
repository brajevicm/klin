@@ -0,0 +1,15 @@
+import csv
+
+
+def validate(path):
+    # The schema inferred from the file is its header: unique, non-empty
+    # column names, and every row has exactly that many fields. Types are not
+    # checked: inferred from the same data they could never disagree.
+    with open(path, newline="") as handle:
+        header, *rows = csv.reader(handle)
+        names = [h.strip() for h in header]
+        if "" in names or len(set(names)) != len(names):
+            raise ValueError(f"{path}: header has empty or duplicate column names")
+        for n, row in enumerate(rows, start=2):
+            if len(row) != len(names):
+                raise ValueError(f"{path}:{n}: expected {len(names)} fields, got {len(row)}")
