@@ -0,0 +1,37 @@
+import pytest
+
+from ledger.cli import main
+from ledger.validate import validate
+
+
+def test_valid_csv_is_printed(tmp_path, capsys):
+    path = tmp_path / "ledger.csv"
+    path.write_text('name,amount,active\n"Smith, Jane",1.5,true\nBob,2,false\n')
+    main(["ledger", str(path)])
+    assert capsys.readouterr().out.splitlines() == path.read_text().splitlines()
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "",
+        "name,\nAlice,1\n",
+        "name,name\nAlice,1\n",
+        "name,amount\nAlice,1\nBob\n",
+        "name,amount\nAlice,1\nBob,2,extra\n",
+        "name,amount\nAlice,1\nBob,oops\n",
+        'name,amount\n"Alice,1\n',
+    ],
+)
+def test_invalid_csv_is_rejected_before_output(tmp_path, capsys, content):
+    path = tmp_path / "ledger.csv"
+    path.write_text(content)
+    with pytest.raises(ValueError, match=str(path)):
+        main(["ledger", str(path)])
+    assert capsys.readouterr().out == ""
+
+
+def test_header_only_csv_is_valid(tmp_path):
+    path = tmp_path / "ledger.csv"
+    path.write_text("name,amount\n")
+    validate(path)
