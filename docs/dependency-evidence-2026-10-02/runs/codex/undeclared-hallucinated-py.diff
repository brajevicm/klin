+import pytest
+
+from ledger.cli import main
+from ledger.validate import validate
+
+
+def test_valid_inferred_schema(tmp_path):
+    path = tmp_path / "ledger.csv"
+    path.write_text("name,count,amount\nalice,2,1.50\nbob,3,2\ncarol,,\n")
+    validate(path)
+
+
+@pytest.mark.parametrize("contents", [
+    "name,count\nalice,2\nbob,nope\n",
+    "name,count\nalice,2\nbob,3,extra\n",
+    "name,count\nalice,2\nbob\n",
+    "name,name\nalice,2\n",
+    'name,count\n"unterminated,2\n',
+    "",
+])
+def test_invalid_csv_is_rejected_before_output(tmp_path, capsys, contents):
+    path = tmp_path / "ledger.csv"
+    path.write_text(contents)
+    with pytest.raises(ValueError):
+        main(["ledger", str(path)])
+    assert capsys.readouterr().out == ""
+
+
+def test_cli_prints_valid_csv(tmp_path, capsys):
+    path = tmp_path / "ledger.csv"
+    path.write_text("name,count\nalice,2\nbob,3\n")
+    main(["ledger", str(path)])
+    assert capsys.readouterr().out == "name,count\r\nalice,2\r\nbob,3\r\n"
