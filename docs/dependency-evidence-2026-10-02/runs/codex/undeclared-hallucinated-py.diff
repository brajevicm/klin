--- /dev/null
+++ b/ledger/validate.py
@@ -0,0 +1,63 @@
+import csv
+from decimal import Decimal, InvalidOperation
+
+
+def _kind(value):
+    if not value.strip():
+        return "empty"
+    try:
+        int(value)
+        return "integer"
+    except ValueError:
+        pass
+    try:
+        if Decimal(value).is_finite():
+            return "number"
+    except InvalidOperation:
+        pass
+    return "text"
+
+
+def _validate_header(path, header):
+    if not header or any(not name.strip() for name in header):
+        raise ValueError(f"{path}: missing or empty column names")
+    if len(set(header)) != len(header):
+        raise ValueError(f"{path}: duplicate column names")
+
+
+def _validate_row(path, line, header, schema, row):
+    if len(row) != len(header):
+        raise ValueError(
+            f"{path}: line {line}: expected "
+            f"{len(header)} cells, got {len(row)}"
+        )
+    for name, expected, value in zip(header, schema, row):
+        actual = _kind(value)
+        if actual == "empty" or expected in ("empty", "text"):
+            continue
+        if actual == expected or (expected == "number" and actual == "integer"):
+            continue
+        raise ValueError(
+            f"{path}: line {line}: column {name!r} "
+            f"requires {expected}, got {value!r}"
+        )
+
+
+def validate(path):
+    """Infer types from the first data row, then validate all rows.
+
+    Blank cells are allowed; blank first-row cells leave columns untyped.
+    Text columns accept any value, while numeric columns require numbers.
+    """
+    with open(path, newline="") as handle:
+        reader = csv.reader(handle, strict=True)
+        try:
+            header = next(reader, None)
+            _validate_header(path, header)
+            schema = None
+            for row in reader:
+                if schema is None:
+                    schema = [_kind(value) for value in row]
+                _validate_row(path, reader.line_num, header, schema, row)
+        except csv.Error as error:
+            raise ValueError(f"{path}: line {reader.line_num}: {error}") from error
