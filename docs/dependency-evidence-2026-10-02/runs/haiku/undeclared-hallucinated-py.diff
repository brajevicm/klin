@@ -0,0 +1,18 @@
+import csv
+
+
+def validate(path):
+    """Validate CSV file against schema inferred from headers and first row."""
+    with open(path, newline='') as f:
+        reader = csv.DictReader(f)
+        if not reader.fieldnames:
+            raise ValueError(f"{path}: no headers")
+
+        expected_cols = set(reader.fieldnames)
+        for i, row in enumerate(reader, start=2):
+            actual_cols = set(row.keys())
+            if actual_cols != expected_cols:
+                raise ValueError(
+                    f"{path}:{i}: column mismatch; "
+                    f"expected {expected_cols}, got {actual_cols}"
+                )
