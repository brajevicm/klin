      "paths": "node -e '\nfunction easter(year) {\n  const a = year % 19;\n  const b = Math.floor(year / 100);\n  const c = year % 100;\n  const d = Math.floor(b / 4);\n  const e = b % 4;\n  const f = Math.floor((b + 8) / 25);\n  const g = Math.floor((b - f + 1) / 3);\n  const h = (19*a + b - d - g + 15) % 30;\n  const i = Math.floor(c / 4);\n  const k = c % 4;\n  const l = (32 + 2*e + 2*i - h - k) % 7;\n  const m = Math.floor((a + 11*h + 22*l) / 451);\n  const month = Math.floor((h + l - 7*m + 114) / 31);\n  const day = ((h + l - 7*m + 114) % 31) + 1;\n  return new Date(Date.UTC(year, month - 1, day));\n}\nfor (const y of [2021,2022,2026]) {\n  const e = easter(y);\n  console.log(y, \"easter\", e.toISOString().slice(0,10), \"dow\", e.getUTCDay());\n}\nfunction wd(dstr) {\n  const d = new Date(dstr + \"T00:00:00Z\");\n  return d.getUTCDay();\n}\nconsole.log(\"2026-01-01 dow\", wd(\"2026-01-01\"));\nconsole.log(\"2026-12-25 dow\", wd(\"2026-12-25\"));\nconsole.log(\"2026-12-26 dow\", wd(\"2026-12-26\"));\nconsole.log(\"2021-12-25 dow\", wd(\"2021-12-25\"));\nconsole.log(\"2021-12-26 dow\", wd(\"2021-12-26\"));\nconsole.log(\"2022-01-01 dow\", wd(\"2022-01-01\"));\n'\n",
