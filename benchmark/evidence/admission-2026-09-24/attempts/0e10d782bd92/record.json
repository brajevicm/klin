st withChristmas = [...withNewYear, christmas];\n  const boxingDay = substitute(new Date(Date.UTC(year, 11, 26)), withChristmas);\n  return [...withChristmas, boxingDay].sort((a,b)=>a-b);\n}\nfor (const year of [2020,2021,2022,2023,2024,2025,2026,2027,2028]) {\n  console.log(year, bankHolidays(year).map(d => d.toISOString().slice(0,10)).join(\", \"));\n}\nEOF\nnode /tmp/check.mjs",
