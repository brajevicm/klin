#!/bin/sh
# The benchmark's host hook. One file serves both arms, byte for byte: the arm is an argument,
# never a difference in this file and never a variable in the host's environment, because the
# subject shell inherits that environment and would read its own arm from it.
#
# Usage: hook <plane> <klin binary> <deliver> <klin arguments...>
#
# <plane>     the control plane for this trial: klin's state, and where this hook writes evidence
# <deliver>   1 to pass klin's answer back to the host, 0 to suppress it
#
# The plane holds klin's state, so KLIN_STATE_DIR is exported here and not by the harness. The
# host would otherwise carry it into the subject shell, which would then read klin's journal and
# find, in the Shadow arm, every finding the treatment withholds.
set -u

plane=$1
klin=$2
deliver=$3
shift 3

# A plane that is not an absolute path means this was called with klin's own arguments first, the
# way the host's settings file wrote them before the arm left the environment. Writing evidence
# under a relative path would scatter a directory wherever the host happened to be.
case "$plane" in
    /*) ;;
    *)
        printf 'hook: the plane must be an absolute path, and it is "%s"\n' "$plane" >&2
        exit 64
        ;;
esac

# Anything but 0 or 1 would run as Shadow and exit 0, so an Active trial would silently deliver
# nothing and the run would be paid for before `verify` said so.
case "$deliver" in
    0 | 1) ;;
    *)
        printf 'hook: deliver must be 0 or 1, and it is "%s"\n' "$deliver" >&2
        exit 64
        ;;
esac

export KLIN_STATE_DIR="$plane/state"
hooks=$plane/hooks

payload=$(cat)

out=$(mktemp)
err=$(mktemp)
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '%s' "$payload" | "$klin" "$@" >"$out" 2>"$err"
status=$?
ended=$(date -u +%Y-%m-%dT%H:%M:%SZ)

mkdir -p "$hooks"
seq=$(find "$hooks" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
# The pid keeps two calls apart if the host ever runs a hook beside another one.
kept="$hooks/$(printf '%04d' "$seq")-$$"
mkdir -p "$kept"
printf '%s' "$payload" >"$kept/payload.json"
printf '%s\n' "$*" >"$kept/arguments"
printf '%s\n' "$status" >"$kept/status"
printf '%s\n' "$deliver" >"$kept/deliver"
printf '%s\n' "$started" >"$kept/started"
printf '%s\n' "$ended" >"$kept/ended"
cp "$out" "$kept/stdout"
cp "$err" "$kept/stderr"

if [ "$deliver" = "1" ]; then
    cat "$out"
    cat "$err" >&2
    rm -f "$out" "$err"
    exit "$status"
fi
rm -f "$out" "$err"
exit 0
