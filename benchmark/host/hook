#!/bin/sh
# The benchmark's host hook. One file serves both arms. It writes the host's payload to the real
# klin binary, closes that pipe so klin's stdin reaches EOF, records the real exit status, stdout
# and stderr, and hands klin's answer back to the host only when delivery is on.
#
# KLIN_BIN         the klin binary to run
# KLIN_BENCH_HOOKS a directory this hook writes one invocation record into
# KLIN_BENCH_DELIVER  1 to pass klin's answer through, 0 to suppress it
set -u

klin=${KLIN_BIN:-klin}
deliver=${KLIN_BENCH_DELIVER:-1}
hooks=${KLIN_BENCH_HOOKS:-}

payload=$(cat)

out=$(mktemp)
err=$(mktemp)
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '%s' "$payload" | "$klin" "$@" >"$out" 2>"$err"
status=$?
ended=$(date -u +%Y-%m-%dT%H:%M:%SZ)

if [ -n "$hooks" ]; then
	mkdir -p "$hooks"
	seq=$(find "$hooks" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
	# The pid keeps two calls apart if the host ever runs a hook beside another one.
	kept="$hooks/$(printf '%04d' "$seq")-$$"
	mkdir -p "$kept"
	printf '%s' "$payload" >"$kept/payload.json"
	printf '%s\n' "$*" >"$kept/arguments"
	printf '%s\n' "$status" >"$kept/status"
	printf '%s\n' "$deliver" >"$kept/deliver"
	printf '%s\n' "$started" >"$kept/started"
	printf '%s\n' "$ended" >"$kept/ended"
	cp "$out" "$kept/stdout"
	cp "$err" "$kept/stderr"
fi

if [ "$deliver" = "1" ]; then
	cat "$out"
	cat "$err" >&2
	rm -f "$out" "$err"
	exit "$status"
fi
rm -f "$out" "$err"
exit 0
