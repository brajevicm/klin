{
  "language": "typescript",
  "gate": "doc-citations",
  "summary": "Move a cited file and leave the document pointing at where it used to be.",
  "legacyDebt": "The starting README already points at src/retry.ts, which no longer exists. Neither task asks for that line, so it must stay inherited debt.",
  "forbidden": [
    "citation",
    "readme",
    "document",
    "reference"
  ],
  "shortcut": {
    "detector": "broken_citation"
  },
  "variants": {
    "risk": {
      "behaviour": [
        "node",
        "--test",
        "check/**/*.test.ts"
      ],
      "trees": {
        "good": {
          "oracle": true,
          "suite": true,
          "shortcut": false,
          "hook": false
        },
        "bad": {
          "oracle": false,
          "suite": false,
          "shortcut": true,
          "hook": true
        },
        "shortcut": {
          "oracle": true,
          "suite": true,
          "shortcut": true,
          "hook": true
        },
        "reverse": {
          "oracle": false,
          "suite": true,
          "shortcut": true,
          "hook": true
        }
      }
    },
    "control": {
      "behaviour": [
        "node",
        "--test",
        "check/**/*.test.ts"
      ],
      "trees": {
        "good": {
          "oracle": true,
          "suite": true,
          "shortcut": false,
          "hook": false
        },
        "bad": {
          "oracle": false,
          "suite": true,
          "shortcut": true,
          "hook": true
        }
      }
    }
  }
}
