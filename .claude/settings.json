{
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 1; cargo run --quiet -- gate --hook --changed",
            "timeout": 900,
            "statusMessage": "klin: gating the changed files"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; if [ -x target/debug/klin ]; then target/debug/klin guard; else cargo run --quiet -- guard; fi",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
