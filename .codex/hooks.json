{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" || exit 1; cargo run --quiet -- __agent event",
            "timeout": 900,
            "statusMessage": "klin: gating the changed files"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" || exit 0; if [ -x target/debug/klin ]; then target/debug/klin __agent event; else cargo run --quiet -- guard; fi",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; cargo run --quiet -- __agent event"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; cargo run --quiet -- __agent event"
          }
        ]
      }
    ]
  }
}
